# ============================================================
# RAG 项目环境变量配置
# 使用方法：复制此文件为 .env 并填入你的 API Key
# ============================================================

# LLM 提供商选择（openai / anthropic / zhipu / qwen）
# 教学演示默认使用 zhipu，启动成本低，国内网络环境也更友好。
LLM_PROVIDER=zhipu

# ============================================================
# OpenAI 配置
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# ============================================================
# Anthropic Claude 配置
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================
# 智谱AI 配置
# ============================================================
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_MODEL=glm-4-flash-250414

# ============================================================
# 通义千问 配置
# ============================================================
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_MODEL=qwen3.6-plus

# ============================================================
# Embedding 模型配置
# ============================================================
# 知识库与查询均为中文，必须用中文模型。英文模型（all-MiniLM-L6-v2）
# 在中文语料上向量检索接近噪声排序。
# 换模型后需重建索引：python scripts/reindex.py
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# ============================================================
# 向量数据库配置
# ============================================================
# 实际 collection 名会自动附加模型指纹，例如
#   techcorp_docs__baai_bge_small_zh_v1_5
# 不同 embedding 模型的向量因此物理隔离，可并存、可 A/B、可回滚。
COLLECTION_NAME=techcorp_docs
SIMILARITY_METRIC=cosine

# ============================================================
# 文本分块配置
# ============================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ============================================================
# 检索配置
# ============================================================
TOP_K_RESULTS=3

# 相关性阈值。两者口径一致：relevance ∈ [0,1] 越大越相关，
# 由 rag/scoring.py 的 compute_relevance() 统一计算。
RETRIEVAL_MIN_RELEVANCE=0.35       # 低于此相关性不进 prompt 上下文
ANSWERABLE_MIN_RELEVANCE=0.75      # 由评测校准（docs/eval/threshold.md）；单一阈值只能识别约两成无答案查询，M3 将引入独立 answerability 判断

# 检索模式（universal / metadata_only / keyword）
RETRIEVAL_MODE=universal
ENABLE_THRESHOLD_FILTERING=true

# ============================================================
# 混合检索与精排
# ============================================================
# 融合方式为 RRF，只用排名不用分数，因此没有向量/BM25 权重参数。
ENABLE_HYBRID=true
HYBRID_TOP_K=20
RRF_K=60                           # RRF 平滑常数（Cormack et al. 2009）

ENABLE_RERANK=false                # 需下载 BAAI/bge-reranker-base
RERANK_TOP_K=20
RERANK_MODEL=BAAI/bge-reranker-base

# ============================================================
# 关系数据库（可追溯轨迹、会话、评测结果）
# ============================================================
# 不填则用 SQLite，零运维起步，本地开发不需要 Docker。
# 生产/多副本必须换 PostgreSQL —— SQLite 单写者模型下并发写会报
# "database is locked"。两者共用同一套模型与 Alembic 迁移，只改这一行。
#
# SQLite（默认）：
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
#
# PostgreSQL（docker compose 起的那个，宿主机侧端口是 15432 不是 5432 ——
# 开发机上常已装有本地 PG 占着 5432，端口错开可避免静默连错库）：
# DATABASE_URL=postgresql+asyncpg://raguser:你的密码@localhost:15432/ragdb

# docker compose 用这三个变量建库。POSTGRES_PASSWORD 没有默认值，
# 不设置时 compose 会直接报错而不是用弱密码起来。
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=改成你自己的密码

# ============================================================
# Redis（缓存、限流、取消信号、摄入进度）
# ============================================================
# Redis 不是事实来源：其中全部内容可丢弃后重建。
# 所有依赖它的功能都必须能降级 —— 限流降级为放行，缓存降级为穿透。
# 因此本地没起 Redis 时把 REDIS_ENABLED 设为 false 即可，功能不受影响。
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# 缓存 TTL（秒）。缓存必须有过期时间，否则会一直增长到打满内存。
CACHE_TTL_RETRIEVAL=3600
CACHE_TTL_EMBEDDING=86400

# 限流：每 IP 每分钟允许的请求数
RATE_LIMIT_PER_MINUTE=30
# 限流窗口（秒），与上一项共同决定配额
RATE_LIMIT_WINDOW_SECONDS=60
# 可信反向代理 IP，逗号分隔。只有请求来自这些 IP 时才采信 X-Forwarded-For。
# 留空 = 不信任任何代理（安全默认）。在 Nginx / Ingress 后部署时填代理 IP，
# 否则所有用户共用代理 IP 的配额。
TRUSTED_PROXY_IPS=

# 异步摄入：pending/running 超过该秒数标为失败（须大于排队+摄入的最长耗时）
INGEST_STALE_SECONDS=1800
INGEST_SWEEP_INTERVAL_SECONDS=300

# ============================================================
# 日志配置
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# 国内网络环境（可选）
# ============================================================
# HuggingFace 模型下载慢时可尝试镜像：
# HF_ENDPOINT=https://hf-mirror.com

# ============================================================
# 使用说明
# ============================================================
#
# 1. 复制此文件:
#    cp .env.example .env
#
# 2. 编辑 .env 文件，填入你的 API Key
#
# 3. 确保 .env 文件在 .gitignore 中（避免泄露 API Key）
#
# 4. 获取 API Key 的地方:
#    - OpenAI: https://platform.openai.com/api-keys
#    - Anthropic: https://console.anthropic.com/
#    - 智谱AI: https://open.bigmodel.cn/
#    - 通义千问: https://dashscope.console.aliyun.com/
#
# ============================================================
